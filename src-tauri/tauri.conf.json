{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Readable",
  "version": "0.1.0",
  "identifier": "app.readable.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Readable",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "media-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data: https://*.supabase.co wss://*.supabase.co",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Readable",
    "copyright": "Copyright © 2026 Readable",
    "category": "Education",
    "shortDescription": "A focused speed-reading app",
    "longDescription": "Readable is a local-first speed reader. Import EPUB, PDF or text and read one word at a time with RSVP."
  }
}
